<tr id="character_equipment_<%= character_equipment.id %>">
  <td><%= character_equipment.character_equipment_data&.equipment %></td>
  <td><%= character_equipment.character_equipment_data&.weight %></td>
  <td><%= character_equipment.quantity %></td>
  <td><%= character_equipment.cost %></td>
  <td>
    <%= button_to "Delete",
          [character_equipment.character, character_equipment],
          method: :delete,
          data: { turbo_stream: true },
          class: "text-red-500 hover:text-red-700" %>
  </td>
</tr>
