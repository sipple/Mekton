<h1>Edit Mecha</h1>

<%= form_with model: @mecha, local: true do |f| %>
  <% if @mecha.errors.any? %>
    <div class="error-explanation">
      <h2><%= pluralize(@mecha.errors.count, "error") %> prohibited this mecha from being saved:</h2>
      <ul>
        <% @mecha.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <p>
    <%= f.label :name %><br />
    <%= f.text_field :name %>
  </p>

  <p>
    <%= f.label :character_id, "Pilot" %><br />
    <%= f.collection_select :character_id,
          policy_scope(Character).active,
          :id, :name,
          prompt: "Select a Pilot" %>
  </p>

  <h2>Modifiers</h2>
  <p>
    <%= f.label :mv_bonus, "MV Bonus" %><br />
    <%= f.number_field :mv_bonus %>
  </p>
  <p>
    <%= f.label :ma_bonus, "MA Bonus" %><br />
    <%= f.number_field :ma_bonus %>
  </p>
  <p>
    <%= f.label :mp_bonus, "Maneuver Pool Bonus (%)" %><br />
    <%= f.number_field :mp_bonus %>
  </p>

  <p>
    <%= f.label :notes %><br />
    <%= f.text_area :notes %>
  </p>

  <p>
    <%= f.submit "Save" %>
    <%= link_to "Cancel", @mecha %>
  </p>
<% end %>
