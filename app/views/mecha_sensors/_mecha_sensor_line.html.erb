<tr id="mecha_sensor_<%= mecha_sensor.id %>">
  <td><%= mecha_sensor.mecha_sensor_data&.sensor %></td>
  <td><%= mecha_sensor.location %></td>
  <td><%= mecha_sensor.mecha_sensor_data&.range %></td>
  <td><%= mecha_sensor.mecha_sensor_data&.kills %></td>
  <td><%= mecha_sensor.cost %></td>
  <td><%= mecha_sensor.mecha_sensor_data&.space %></td>
  <td>
    <%= button_to "Delete",
          [mecha_sensor.mecha, mecha_sensor],
          method: :delete,
          data: { turbo_stream: true },
          class: "text-red-500 hover:text-red-700" %>
  </td>
</tr>
