<tr id="character_skill_<%= character_skill.id %>">
  <td><%= character_skill.character_skill_data&.skill %></td>
  <td><%= character_skill.level %></td>
  <td><%= character_skill.ip_earned %></td>
  <td><%= character_skill.attribute_bonus %></td>
  <td><%= character_skill.total %></td>
  <td>
    <%= button_to "Delete",
          [character_skill.character, character_skill],
          method: :delete,
          data: { turbo_stream: true },
          class: "text-red-500 hover:text-red-700" %>
  </td>
</tr>
