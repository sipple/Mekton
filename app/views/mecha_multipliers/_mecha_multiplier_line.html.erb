<tr id="mecha_multiplier_<%= mecha_multiplier.id %>">
  <td><%= mecha_multiplier.mecha_multiplier_data&.multiplier %></td>
  <td><%= mecha_multiplier.quantity %></td>
  <td><%= mecha_multiplier.cost %></td>
  <td>
    <%= button_to "Delete",
          [mecha_multiplier.mecha, mecha_multiplier],
          method: :delete,
          data: { turbo_stream: true },
          class: "text-red-500 hover:text-red-700" %>
  </td>
</tr>
