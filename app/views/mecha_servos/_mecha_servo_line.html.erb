<tr id="mecha_servo_<%= mecha_servo.id %>">
  <td><%= mecha_servo.mecha_armor_data&.stopping_power %></td>
  <td><%= mecha_servo.mecha_servo_level_data&.kills %></td>
  <td><%= mecha_servo.mecha_servo_data&.servo %></td>
  <td><%= mecha_servo.mecha_servo_level_data&.level %></td>
  <td><%= mecha_servo.mecha_servo_level_data&.space %></td>
  <td><%= mecha_servo.mecha_servo_level_data&.cost %></td>
  <td><%= mecha_servo.mecha_armor_data&.armor %></td>
  <td><%= mecha_servo.mecha_armor_data&.cost %></td>
  <td>
    <%= button_to "Delete",
          [mecha_servo.mecha, mecha_servo],
          method: :delete,
          data: { turbo_stream: true },
          class: "text-red-500 hover:text-red-700" %>
  </td>
</tr>
