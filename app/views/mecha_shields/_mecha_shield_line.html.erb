<tr id="mecha_shield_<%= mecha_shield.id %>">
  <td><%= mecha_shield.mecha_shield_data&.shield %></td>
  <td><%= mecha_shield.mecha_shield_data&.defense_adjustment %></td>
  <td><%= mecha_shield.mecha_shield_data&.stopping_power %></td>
  <td><%= mecha_shield.location %></td>
  <td><%= mecha_shield.mecha_shield_data&.space %></td>
  <td><%= mecha_shield.cost %></td>
  <td>
    <%= button_to "Delete",
          [mecha_shield.mecha, mecha_shield],
          method: :delete,
          data: { turbo_stream: true },
          class: "text-red-500 hover:text-red-700" %>
  </td>
</tr>
