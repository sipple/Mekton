<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mekton V2" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mekton V2">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-gray-50">
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <%= link_to "Mekton RPG", root_path, class: "text-lg font-bold text-gray-900" %>
        <div class="flex items-center gap-4 text-sm">
          <% if user_signed_in? %>
            <span class="text-gray-600"><%= current_user.email %></span>
            <% if current_user.admin? %>
              <span class="text-xs bg-amber-100 text-amber-800 px-2 py-0.5 rounded-full">Admin</span>
            <% end %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                  class: "text-gray-500 hover:text-gray-700" %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "text-gray-600 hover:text-gray-900" %>
            <%= link_to "Sign up", new_user_registration_path,
                  class: "bg-gray-900 text-white px-3 py-1.5 rounded-md hover:bg-gray-800" %>
          <% end %>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="max-w-5xl mx-auto px-4 mt-4">
        <p class="bg-green-50 text-green-800 border border-green-200 rounded-md px-4 py-3 text-sm"><%= notice %></p>
      </div>
    <% end %>
    <% if alert %>
      <div class="max-w-5xl mx-auto px-4 mt-4">
        <p class="bg-red-50 text-red-800 border border-red-200 rounded-md px-4 py-3 text-sm"><%= alert %></p>
      </div>
    <% end %>

    <main class="max-w-5xl mx-auto px-4 py-8">
      <%= yield %>
    </main>
  </body>
</html>
