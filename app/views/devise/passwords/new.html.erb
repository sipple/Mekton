<h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Forgot your password?</h2>

<div class="w-full max-w-md mx-auto bg-white shadow-md rounded-lg p-6">
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:border-transparent" %>
    </div>

    <div class="mb-4">
      <%= f.submit "Send me password reset instructions", class: "w-full bg-gray-900 text-white py-2 px-4 rounded-md hover:bg-gray-800 cursor-pointer transition-colors" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
