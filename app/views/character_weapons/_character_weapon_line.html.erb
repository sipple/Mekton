<tr id="character_weapon_<%= character_weapon.id %>">
  <td><%= character_weapon.character_weapon_data&.weapon %></td>
  <td><%= character_weapon.character_weapon_data&.weapon_adjustment %></td>
  <td><%= character_weapon.character_weapon_data&.range %></td>
  <td><%= character_weapon.character_weapon_data&.damage %></td>
  <td><%= character_weapon.character_weapon_data&.shots %></td>
  <td><%= character_weapon.character_weapon_data&.burst_value %></td>
  <td><%= character_weapon.character_weapon_data&.concealment %></td>
  <td><%= character_weapon.character_weapon_data&.weight %></td>
  <td><%= character_weapon.quantity %></td>
  <td><%= character_weapon.cost %></td>
  <td>
    <%= button_to "Delete",
          [character_weapon.character, character_weapon],
          method: :delete,
          data: { turbo_stream: true },
          class: "text-red-500 hover:text-red-700" %>
  </td>
</tr>
