<tr id="character_armor_<%= character_armor.id %>">
  <td><%= character_armor.character_armor_data&.armor %></td>
  <td><%= character_armor.location %></td>
  <td><%= character_armor.character_armor_data&.stopping_power %></td>
  <td><%= character_armor.character_armor_data&.cost %></td>
  <td><%= character_armor.character_armor_data&.weight %></td>
  <td>
    <%= button_to "Delete",
          [character_armor.character, character_armor],
          method: :delete,
          data: { turbo_stream: true },
          class: "text-red-500 hover:text-red-700" %>
  </td>
</tr>
