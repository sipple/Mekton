<table>
  <thead class="shaded">
    <tr>
      <th>Weapon</th>
      <th>WA</th>
      <th>Range</th>
      <th>Damage</th>
      <th>Shots</th>
      <th>BV</th>
      <th>Conc</th>
      <th>Weight</th>
      <th>Qty</th>
      <th>Cost</th>
    </tr>
  </thead>
  <tbody id="character_weapons_body">
    <% local_assigns[:character_weapons].each do |weapon| %>
      <%= render "character_weapons/character_weapon_line", character_weapon: weapon %>
    <% end %>
    <tr id="character_weapons-add">
      <td>
        <%= button_to "Add Weapon",
              [character, :character_weapons],
              method: :post,
              data: { turbo_stream: true },
              class: "text-green-500 hover:text-green-700" %>
      </td>
    </tr>
  </tbody>
</table>
