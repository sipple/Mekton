<table>
  <thead class="shaded">
    <tr>
      <th>Skill</th>
      <th>Level</th>
      <th>IP</th>
      <th>Attr</th>
      <th>Total</th>
    </tr>
  </thead>
  <tbody id="character_skills_body">
    <% local_assigns[:character_skills].each do |skill| %>
      <%= render "character_skills/character_skill_line", character_skill: skill %>
    <% end %>
    <tr id="character_skills-add">
      <td>
        <%= button_to "Add Skill",
              [character, :character_skills],
              method: :post,
              data: { turbo_stream: true },
              class: "text-green-500 hover:text-green-700" %>
      </td>
    </tr>
  </tbody>
</table>
