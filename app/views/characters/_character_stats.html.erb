<table id="character-stats-table">
  <thead class="shaded">
    <tr>
      <th colspan="4">Character Stats</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td class="stat-value"><%= character.intelligence %></td><td class="stat-label shaded">Intelligence</td>
      <td class="stat-value"><%= character.melee_damage_mod %></td><td class="stat-label shaded">Melee Damage Mod</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.cool %></td><td class="stat-label shaded">Cool</td>
      <td class="stat-value"><%= character.stability %></td><td class="stat-label shaded">Stability</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.reflexes %></td><td class="stat-label shaded">Reflexes</td>
      <td class="stat-value"><%= character.run %></td><td class="stat-label shaded">Run</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.attractiveness %></td><td class="stat-label shaded">Attractiveness</td>
      <td class="stat-value"><%= character.jump %></td><td class="stat-label shaded">Jump</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.empathy %></td><td class="stat-label shaded">Empathy</td>
      <td class="stat-value"><%= character.running_jump %></td><td class="stat-label shaded">Running Jump</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.tech_ability %></td><td class="stat-label shaded">Tech Ability</td>
      <td class="stat-value"><%= character.anime_leap %></td><td class="stat-label shaded">Anime Leap</td>
    </tr>
     <tr>
      <td class="stat-value"><%= character.luck %></td><td class="stat-label shaded">Luck</td>
      <td class="stat-value"><%= character.stun %></td><td class="stat-label shaded">Stun</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.move_allowance %></td><td class="stat-label shaded">Move Allowance</td>
      <td class="stat-value"><%= character.lift %></td><td class="stat-label shaded">Lift</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.body_type %></td><td class="stat-label shaded">Body Type</td>
      <td class="stat-value"><%= character.ev %></td><td class="stat-label shaded">EV</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.education %></td><td class="stat-label shaded">Education</td>
      <td class="stat-value"><%= character.throw_distance %></td><td class="stat-label shaded">Throw</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.psi_ability %></td><td class="stat-label shaded">Psi Ability</td>
      <td class="stat-value"><%= character.psi_points %></td><td class="stat-label shaded">Psi Points</td>
     </tr>
    <tr class="top-border">
      <td class="stat-label shaded" colspan="2">Hit Damage Capacities</td>
      <td class="stat-value"><%= character.limbs %></td><td class="stat-label shaded">Limbs</td>
    </tr>
    <tr>
      <td class="stat-value"><%= character.head %></td><td class="stat-label shaded">Head</td>
      <td class="stat-value"><%= character.torso %></td><td class="stat-label shaded">Torso</td>
    </tr>
  </tbody>
</table>
