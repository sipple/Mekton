<table>
  <thead class="character-table-header shaded">
    <tr>
      <th>Equipment</th>
      <th>Wgt</th>
      <th>Qty</th>
      <th>Cost</th>
    </tr>
  </thead>
  <tbody id="character_equipments_body">
    <% local_assigns[:character_equipments].each do |equipment| %>
      <%= render "character_equipments/character_equipment_line", character_equipment: equipment %>
    <% end %>
    <tr id="character_equipments-add">
      <td>
        <%= link_to "Add Equipment",
              [character, :character_equipments],
              data: { turbo_method: :post },
              class: "text-green-500 hover:text-green-700" %>
      </td>
    </tr>
  </tbody>
</table>
