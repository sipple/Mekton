<table>
  <thead class="shaded">
    <tr>
      <th>Armor</th>
      <th>Location</th>
      <th>SP</th>
      <th>Cost</th>
      <th>Weight</th>
    </tr>
  </thead>
  <tbody id="character_armors_body">
    <% local_assigns[:character_armors].each do |armor| %>
      <%= render "character_armors/character_armor_line", character_armor: armor %>
    <% end %>
    <tr id="character_armors-add">
      <td>
        <%= link_to "Add Armor",
              [character, :character_armors],
              data: { turbo_method: :post },
              class: "text-green-500 hover:text-green-700" %>
      </td>
    </tr>
  </tbody>
</table>
