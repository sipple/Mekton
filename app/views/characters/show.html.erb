<div id="character-sheet">
<div id="character-left">
    <div id="character-personal" class="character-section">
      <div class="side-label label shaded">
         Name:
      </div>
      <div class="shaded">
        <%= @character.name %>
      </div>
      <div id="portrait">

      </div>
    </div>
    <div id="character-equipments-div" class="character-section">
      <%= render "character_equipments",
            character: @character,
            character_equipments: @character.character_equipments %>
    </div>
    <div id="character-notes-div" class="character-section">
      <strong>Notes</strong><br/>
      <%= @character.notes %>
    </div>
</div>

<div id="character-right">
    <div id="character-header" class="character-section">
      <div class="top-label label shaded">
        Rookie/Professional
      </div>
      <div id="character-type" class="side-stat">
        <%= @character.character_type %>
      </div>
      <div class="side-label label shaded">
        Age
      </div>
      <div id="character-age" class="side-stat">
        <%= @character.age %>
      </div>
      <div class="side-label label shaded">
        Money
      </div>
      <div id="character-money" class="side-stat">
        <%= @character.money %>
      </div>
    </div>

    <div id="character_stats">
      <%= render "character_stats", character: @character %>
    </div>

    <div id="character-weapons-div" class="character-section">
      <%= render "character_weapons",
            character: @character,
            character_weapons: @character.character_weapons %>
    </div>

    <div id="character_armors-div" class="character-section">
      <%= render "character_armors",
            character: @character,
            character_armors: @character.character_armors %>
    </div>

    <div id="character-skills-div" class="character-section">
      <%= render "skill_points", character: @character %>
      <%= render "character_skills",
            character: @character,
            character_skills: @character.character_skills %>
    </div>
</div>
</div>
